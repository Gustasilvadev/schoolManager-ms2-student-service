generator client {
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model responsibles {
  responsible_id       Int                    @id @default(autoincrement())
  responsible_name     String                 @db.VarChar(45)
  responsible_email    String                 @unique(map: "responsible_email_UNIQUE") @db.VarChar(45)
  responsible_status   Int
  student_responsibles student_responsibles[]
}

model student_responsibles {
  student_responsible_id Int          @id @default(autoincrement())
  student_id             Int
  responsible_id         Int
  students               students     @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_student_responsible_key_1")
  responsibles           responsibles @relation(fields: [responsible_id], references: [responsible_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_student_responsible_key_2")

  @@index([student_id], map: "fk_student_responsible_key_1_idx")
  @@index([responsible_id], map: "fk_student_responsible_key_2_idx")
}

model students {
  student_id           Int                    @id @default(autoincrement())
  student_name         String                 @db.VarChar(45)
  student_birthday     DateTime               @db.Date
  student_cpf          String                 @db.VarChar(15)
  student_email        String                 @unique(map: "student_email_UNIQUE") @db.VarChar(45)
  student_status       Int
  student_responsibles student_responsibles[]
}
